# ---- HumanGPT configuration ----
# Copy to `.env` and adjust.

# Network
HOST=127.0.0.1
PORT=8000

# Where the SQLite database lives.
DB_PATH=data/humangpt.db

# Static API key check.
# Leave unset/empty to accept ANY `Authorization: Bearer <anything>`
# (convenient for local QA). When set, incoming requests MUST carry
# exactly this key.
# OPENAI_API_KEY=

# How long a request may sit pending in the human queue before the
# parked client HTTP request is released with an automatic timeout.
# 0 disables the auto-timeout entirely.
MOCK_REQUEST_TIMEOUT_S=600

# Delay between streamed words.
# 0 = deliver each word as fast as the operator types it (recommended default).
# Higher values let humans watch a slower "typing" effect.
# Only applies to word-chunk streaming, not whole-message mode.
MOCK_STREAM_CHUNK_DELAY_MS=0

# Default streaming delivery mode (overridable in the Settings page):
#   word-chunk = words stream LIVE as the operator types, then locked
#   once       = whole message submitted, then delivered as a single chunk
MOCK_STREAM_MODE=word-chunk

# Path to the JSON file listing served model ids.
# Shape: {"models": ["human-gpt", ...]}
MODELS_CONFIG=models.json

# CORS origins for browsers calling this server directly (comma-separated).
# The web UI is same-origin, so this is only needed if you point JS at it
# from another origin.
CORS_ORIGINS=*

# Lifespan of SSE connections in the operator UI (seconds), and the
# fallback poll interval the UI falls back to.
UI_SSE_KEEPALIVE_S=25
UI_POLL_INTERVAL_S=10